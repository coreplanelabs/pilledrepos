{
  "name": "@coreplane/pilledrepos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node scripts/clean.mjs --tests && tsc -p tsconfig.test.json && tsc -p tsconfig.server.json && node --test .test-dist/test/*.test.js test/*.test.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.server.json && node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "index": "node scripts/refresh-index.mjs",
    "preview:seed": "node scripts/seed.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "backfill": "node scripts/refresh-index.mjs --discover",
    "publish:index": "node scripts/publish-index.mjs",
    "seed:repos": "node scripts/seed-top-repos.mjs",
    "enroll:index": "node scripts/enroll-index.mjs",
    "list:index": "node scripts/indexed-repos.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "wrangler": "4.148.0",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.0-alpha"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coreplanelabs/pilledrepos.git"
  },
  "homepage": "https://pilledrepos.com",
  "description": "Verified AI-agent PR authorship metrics for public GitHub repositories"
}
